# Copy to .env. Do not commit real keys. No providers silently incur paid LLM usage.
LLM_PROVIDER=auto
PROVIDER_PRIORITY=openrouter,gemini,nvidia
TINYFISH_API_KEY=
TINYFISH_AGENT_ENABLED=false
PLAYWRIGHT_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Enable only after confirming this key/project uses the free tier (not billing).
GEMINI_FREE_TIER_CONFIRMED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
NVIDIA_API_KEY=
NVIDIA_MODEL=
NVIDIA_FREE_TIER_CONFIRMED=false
LOCAL_BASE_URL=http://127.0.0.1:8001/v1
LOCAL_MODEL=
MAX_ESTIMATED_API_COST_USD=0
MAX_OUTPUT_TOKENS=1000
TEMPERATURE=0
LLM_RETRY_LIMIT=1
PROVIDER_MIN_INTERVAL_S=1
TIME_BUDGET_S=30
REQUEST_TIMEOUT_S=8
MAX_PAGES=8
MAX_HOPS=2
MAX_ATTEMPTS=3
CONCURRENCY=3
CACHE_TTL_S=0
